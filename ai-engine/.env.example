KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=compose.request
KAFKA_GROUP_ID=ourcut-ai-engine
CORE_API_URL=http://localhost:8080
AI_ENGINE_SECRET=change-me
STORAGE_ROOT=.data/objects
CALLBACK_TIMEOUT_SECONDS=10
CALLBACK_MAX_RETRIES=3
SEGMENTATION_BACKEND=rembg
SEGMENTATION_MODEL=u2net_human_seg
SEGMENTATION_ALPHA_MATTING=false
SEGMENTATION_FOREGROUND_THRESHOLD=240
SEGMENTATION_BACKGROUND_THRESHOLD=10
SEGMENTATION_ERODE_SIZE=10
POSE_LANDMARKS_ENABLED=true
POSE_MIN_DETECTION_CONFIDENCE=0.5
POSE_MIN_LANDMARK_VISIBILITY=0.5
POSE_BBOX_PADDING=0.08
OPENAI_API_KEY=
GEMINI_API_KEY=
PROMPT_MODEL=gpt-4.1-mini
IMAGE_MODEL=gpt-image-2.5-sunburst
VIDEO_MODEL=veo-3.1-generate-preview
IMAGE_PROVIDER=openai
VIDEO_PROVIDER=google
IMAGE_QUALITY=high
IMAGE_SIZE=1024x1024
VIDEO_DURATION_SECONDS=8
VIDEO_ASPECT_RATIO=9:16
VIDEO_GENERATE_AUDIO=true
GENERATION_TIMEOUT_SECONDS=300
