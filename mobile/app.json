{
  "expo": {
    "name": "OURCUT",
    "slug": "ourcut",
    "scheme": "ourcut",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "프레임에 넣을 사진을 고르기 위해 앨범에 접근합니다.",
          "cameraPermission": "프레임에 넣을 사진을 촬영하기 위해 카메라를 사용합니다."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF4E8",
          "image": "./assets/images/mascot-strip.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/images/app-icon.png",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon.png",
        "backgroundColor": "#FFF4E8"
      }
    }
  }
}
